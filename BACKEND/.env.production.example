# Copiar a .env.production en el servidor (nunca commitear).
# Guia: docs/SUPABASE_QUICKSTART.md

COMPOSE_PROJECT_NAME=e-vidente

POSTGRES_HOST=aws-0-us-east-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.TU_PROJECT_REF
POSTGRES_PASSWORD=
POSTGRES_SSL=true
POSTGRES_POOL_MAX=8

BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
BACKEND_BASE_URL=https://api.tudominio.com
NODE_ENV=production

JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

EMAIL_ENABLED=true
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=E-VIDENTE
EMAIL_CRON_SECRET=
EMAIL_TIMEZONE=America/Argentina/Buenos_Aires
EMAIL_PENDING_STALE_MINUTES=15
EMAIL_BATCH_CONCURRENCY=5
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_MAX_AGE_HOURS=48
EMAIL_RETRY_BATCH_LIMIT=50
EMAIL_REQUEST_TIMEOUT_MS=15000
EMAIL_REQUEST_MAX_ATTEMPTS=3
EMAIL_REQUEST_RETRY_BASE_MS=500
EMAIL_PROCESS_ON_STARTUP=true
EMAIL_PENDING_WELCOME_BATCH_LIMIT=25
BREVO_WEBHOOK_SECRET=
