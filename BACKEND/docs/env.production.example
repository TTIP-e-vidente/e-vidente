# Copiá a BACKEND/.env.production (gitignored)
# Plantilla — ver BACKEND/docs/SUPABASE_EDGE_FUNCTIONS.md sección Producción

NODE_ENV=production
POSTGRES_SSL=true
POSTGRES_HOST=aws-1-us-east-1.pooler.supabase.com
POSTGRES_USER=postgres.TU_PROJECT_REF
POSTGRES_PASSWORD="password-con-comillas-si-tiene-#"
POSTGRES_DB=postgres
POSTGRES_PORT=5432
POSTGRES_POOL_MAX=8

SUPABASE_PROJECT_REF=TU_PROJECT_REF
SUPABASE_POOLER_PREFIX=aws-1
SUPABASE_POOLER_REGION=us-east-1
SUPABASE_ANON_KEY=

JWT_SECRET=generar-secret-largo-32-chars-minimo
JWT_EXPIRES_IN=7d

BACKEND_BASE_URL=https://TU-SERVICIO.onrender.com

EMAIL_ENABLED=true
EMAIL_CRON_SECRET=generar-secret-cron-distinto-al-staging
BREVO_API_KEY=
BREVO_SENDER_EMAIL=mail-verificado@tudominio.com
BREVO_SENDER_NAME=E-VIDENTE
EMAIL_TIMEZONE=America/Argentina/Buenos_Aires
EMAIL_PROCESS_ON_STARTUP=false
