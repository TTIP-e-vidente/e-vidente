{
  "name": "e-vidente-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:staging",
    "dev:local": "ts-node scripts/sync-godot-backend-config.ts && ts-node scripts/start-dev-if-needed.ts",
    "dev:stop": "ts-node scripts/stop-dev-server.ts",
    "dev:restart": "npm run dev:stop && npm run dev",
    "dev:restart:local": "npm run dev:stop && npm run dev:local",
    "build": "tsc && node scripts/copy-email-assets.cjs",
    "start": "node dist/server.js",
    "migrate": "ts-node scripts/run-migrations.ts",
    "smoke:api": "ts-node scripts/smoke-auth-player.ts",
    "smoke:leaderboard": "ts-node scripts/smoke-leaderboard.ts",
    "seed:dev": "ts-node scripts/seed-dev-users.ts",
    "setup:dev": "ts-node scripts/setup-dev.ts",
    "setup:supabase": "ts-node scripts/setup-supabase-staging.ts",
    "supabase:init": "ts-node scripts/init-supabase-env.ts",
    "supabase:diagnose": "ts-node scripts/diagnose-supabase.ts",
    "supabase:status": "ts-node scripts/supabase-status.ts",
    "supabase:bootstrap": "ts-node scripts/bootstrap-supabase.ts",
    "supabase:bootstrap:apply": "ts-node scripts/bootstrap-supabase.ts --apply",
    "supabase:bootstrap:apply:seed": "ts-node scripts/bootstrap-supabase.ts --apply --seed",
    "supabase:bootstrap:full": "ts-node scripts/bootstrap-supabase.ts --apply --with-data --with-smoke --seed",
    "migrate:supabase": "ts-node scripts/with-env-file.ts .env.staging npx ts-node scripts/run-migrations.ts",
    "migrate:data-to-supabase:dry-run": "ts-node scripts/migrate-data-local-to-supabase.ts --dry-run",
    "migrate:data-to-supabase": "ts-node scripts/migrate-data-local-to-supabase.ts --apply",
    "migrate:all-to-supabase": "ts-node scripts/migrate-all-to-supabase.ts",
    "verify:supabase": "ts-node scripts/verify-supabase.ts",
    "verify:supabase:compare-local": "ts-node scripts/verify-supabase.ts --compare-local",
    "check:deploy": "ts-node scripts/check-deploy-readiness.ts",
    "check:deploy:staging": "ts-node scripts/with-env-file.ts .env.staging npx ts-node scripts/check-deploy-readiness.ts",
    "seed:staging": "ts-node scripts/with-env-file.ts .env.staging npx ts-node scripts/seed-dev-users.ts",
    "deploy:migrate": "ts-node scripts/deploy-migrate.ts",
    "start:prod": "node dist/scripts/deploy-migrate.js && node dist/server.js",
    "smoke:api:staging": "ts-node scripts/with-env-file.ts .env.staging npx ts-node scripts/smoke-auth-player.ts",
    "smoke:cron:staging": "ts-node scripts/with-env-file.ts .env.staging npx ts-node scripts/smoke-cron.ts",
    "smoke:staging": "npm run smoke:api:staging",
    "staging:verify": "ts-node scripts/staging-verify.ts",
    "staging:verify:email": "ts-node scripts/staging-verify.ts --email",
    "staging:data-audit": "ts-node scripts/with-env-file.ts .env.staging npx ts-node scripts/staging-data-audit.ts",
    "dev:staging": "ts-node scripts/dev-staging.ts",
    "sync:staging-secrets": "ts-node scripts/sync-staging-secrets.ts",
    "sync:godot-config": "ts-node scripts/sync-godot-backend-config.ts",
    "email:streaks": "ts-node scripts/send-streak-emails.ts",
    "email:retry-failed": "ts-node scripts/retry-failed-emails.ts",
    "email:run-local": "ts-node scripts/run-email-outbound.ts",
    "test:email": "ts-node scripts/test-email-send.ts",
    "generate:email-icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-email-icons.ps1",
    "smoke:email": "ts-node scripts/smoke-email.ts",
    "smoke:email:staging": "ts-node scripts/with-env-file.ts .env.staging npx ts-node scripts/smoke-email.ts",
    "smoke:email-verification": "ts-node scripts/smoke-email-verification.ts",
    "smoke:email-verification:staging": "ts-node scripts/with-env-file.ts .env.staging npx ts-node scripts/smoke-email-verification.ts",
    "seed:streak-email-demo": "ts-node scripts/seed-streak-email-demo.ts",
    "validate:email-flow": "ts-node scripts/validate-email-flow.ts",
    "validate:email-flow:staging": "ts-node scripts/with-env-file.ts .env.staging npx ts-node scripts/validate-email-flow.ts",
    "test:email:staging": "ts-node scripts/with-env-file.ts .env.staging npx ts-node scripts/test-email-send.ts",
    "test": "npm run migrate && ts-node scripts/run-integration-tests.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
