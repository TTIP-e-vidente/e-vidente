# Copiar a .env.staging y completar credenciales Supabase.
# Guia: docs/SUPABASE_MIGRATION.md

COMPOSE_PROJECT_NAME=e-vidente

# --- Migraciones / setup:supabase (conexion DIRECTA) ---
POSTGRES_HOST=db.TU_PROJECT_REF.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_SSL=true

# --- Runtime (dev:staging): opcional Session pooler ---
# POSTGRES_HOST=aws-0-us-east-1.pooler.supabase.com
# POSTGRES_USER=postgres.TU_PROJECT_REF

BACKEND_PORT=3010
BACKEND_HOST=localhost
NODE_ENV=development

JWT_SECRET=cambiar_por_secret_largo_staging
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

EMAIL_ENABLED=true
BREVO_API_KEY=
BREVO_SENDER_EMAIL=evidente2026@gmail.com
BREVO_SENDER_NAME=E-VIDENTE
EMAIL_CRON_SECRET=cambiar_staging
EMAIL_TIMEZONE=America/Argentina/Buenos_Aires
EMAIL_PENDING_STALE_MINUTES=15
EMAIL_BATCH_CONCURRENCY=5
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_MAX_AGE_HOURS=48
EMAIL_RETRY_BATCH_LIMIT=50
EMAIL_REQUEST_TIMEOUT_MS=15000
EMAIL_REQUEST_MAX_ATTEMPTS=3
EMAIL_REQUEST_RETRY_BASE_MS=500
EMAIL_PROCESS_ON_STARTUP=true
EMAIL_PENDING_WELCOME_BATCH_LIMIT=25
BREVO_WEBHOOK_SECRET=
