# Copiar a BACKEND/.env.staging (gitignored) o pegar en el secret manager del deploy.
# Proyecto Supabase de staging. Valores en Dashboard -> Settings -> Database.

COMPOSE_PROJECT_NAME=e-vidente
POSTGRES_SSL=true
# Session pooler (recomendado para Express + transacciones). Reemplazar <project-ref> y region.
POSTGRES_HOST=aws-0-sa-east-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.<project-ref>
POSTGRES_PASSWORD=

# Para npm run migrate contra Supabase, usar conexion DIRECT temporalmente:
# POSTGRES_HOST=db.<project-ref>.supabase.co
# POSTGRES_USER=postgres

BACKEND_PORT=3010
NODE_ENV=staging
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
EMAIL_ENABLED=true
BREVO_API_KEY=
BREVO_SENDER_EMAIL=evidente2026@gmail.com
BREVO_SENDER_NAME=E-VIDENTE
EMAIL_CRON_SECRET=
EMAIL_TIMEZONE=America/Argentina/Buenos_Aires
EMAIL_PENDING_STALE_MINUTES=15
EMAIL_BATCH_CONCURRENCY=5
EMAIL_RETRY_MAX_ATTEMPTS=3
EMAIL_RETRY_MAX_AGE_HOURS=48
EMAIL_RETRY_BATCH_LIMIT=50
EMAIL_REQUEST_TIMEOUT_MS=15000
EMAIL_REQUEST_MAX_ATTEMPTS=3
EMAIL_REQUEST_RETRY_BASE_MS=500
EMAIL_PROCESS_ON_STARTUP=false
EMAIL_PENDING_WELCOME_BATCH_LIMIT=25
BREVO_WEBHOOK_SECRET=
