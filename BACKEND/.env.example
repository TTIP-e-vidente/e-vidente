COMPOSE_PROJECT_NAME=e-vidente
POSTGRES_HOST=localhost
POSTGRES_DB=evidente_dev
POSTGRES_USER=evidente_user
POSTGRES_PASSWORD=evidente_password
# 5433 evita conflicto con Postgres instalado en Windows (puerto 5432 ocupado).
POSTGRES_PORT=5433
# false = Docker local. true = Supabase u otro Postgres remoto (activa SSL en pg).
POSTGRES_SSL=false
# Remoto (Supabase): POSTGRES_POOL_MAX=8 recomendado con Session pooler
# POSTGRES_POOL_MAX=8
# Staging Supabase: npm run supabase:init → docs/SUPABASE_QUICKSTART.md
# SUPABASE_PROJECT_REF=kpvjdzdynqfhqfiatwqz
# SUPABASE_ANON_KEY=   ← Dashboard Supabase → Settings → API (anon public)
# Con POSTGRES_SSL=true los mails van solo por Edge (verify + jobs). Ver docs/SUPABASE_EDGE_FUNCTIONS.md
# EMAIL_VIA_SUPABASE_EDGE=true   ← default con Supabase; false solo para debug local legacy
BACKEND_PORT=3010
# Opcional: host distinto de localhost (default localhost).
# BACKEND_HOST=localhost
NODE_ENV=development
JWT_SECRET=evidente_local_dev_secret_change_me
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
EMAIL_ENABLED=true
# Pegar solo en BACKEND/.env (gitignored). Rotar en Brevo si se expuso. Ver docs/BREVO_SETUP.md
BREVO_API_KEY=
# Debe coincidir con un remitente Verified en Brevo (Senders & IP).
BREVO_SENDER_EMAIL=evidente2026@gmail.com
BREVO_SENDER_NAME=E-VIDENTE
EMAIL_CRON_SECRET=evidente_email_cron_local_dev_change_me
EMAIL_TIMEZONE=America/Argentina/Buenos_Aires
EMAIL_PENDING_STALE_MINUTES=15
EMAIL_BATCH_CONCURRENCY=5
# Reintentos del outbox con backoff: 2.º intento +10 min, 3.º +1 h, 4.º +6 h.
EMAIL_RETRY_MAX_ATTEMPTS=4
EMAIL_RETRY_MAX_AGE_HOURS=48
EMAIL_RETRY_BATCH_LIMIT=50
EMAIL_REQUEST_TIMEOUT_MS=15000
EMAIL_REQUEST_MAX_ATTEMPTS=3
EMAIL_REQUEST_RETRY_BASE_MS=500
EMAIL_PROCESS_ON_STARTUP=true
EMAIL_PENDING_WELCOME_BATCH_LIMIT=25
BREVO_WEBHOOK_SECRET=
# Solo para npm run smoke:email -- --send
SMOKE_EMAIL_TO=
# Avatares (secret de Edge Functions): si Storage falla, true (default) guarda
# base64 legacy en images.data; false devuelve STORAGE_UNAVAILABLE.
# Ver docs/AVATARS_STORAGE.md
# AVATAR_BASE64_FALLBACK=true
