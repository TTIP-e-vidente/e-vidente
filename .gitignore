# Godot 4+ specific ignores
juego/.godot/
*.import
# Los .import de assets versionados fijan los UID entre máquinas (evita "invalid UID" al clonar).
!juego/assets-sistema/**/*.import
!juego/fonts/**/*.import

# Validation save directory (local dev artifact, never commit save state)
.godot-validation-save/

# GdUnit4 reportes generados (outputs de test runs)
juego/reports/

# Local environment and database artifacts
.env
*.env
!*.env.example
BACKEND/.env
BACKEND/.env.staging
juego/config/backend.local.json
BACKEND/postgres-data/
BACKEND/pgdata/
BACKEND/node_modules/
BACKEND/dist/
backend/.env
backend/postgres-data/
backend/pgdata/

# Ignore docs-local anywhere in the project
docs-local/
**/docs-local/

# OS and temporary files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tmp
*.temp
