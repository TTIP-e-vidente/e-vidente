# Godot 4+ specific ignores
juego/.godot/
*.import

# Validation save directory (local dev artifact, never commit save state)
.godot-validation-save/

# GdUnit4 reportes generados (outputs de test runs)
juego/reports/

# Local environment and database artifacts
.env
*.env
!*.env.example
BACKEND/.env
BACKEND/postgres-data/
BACKEND/pgdata/
BACKEND/node_modules/
BACKEND/dist/
backend/.env
backend/postgres-data/
backend/pgdata/

# Legacy local docs folder
docs-local/
!docs-local/
docs-local/*
!docs-local/.gitkeep

# OS and temporary files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tmp
*.temp
